# Placeholder only. Do not commit a populated .env.
# Deploy names match ops/.env.example. Copy that file to ops/.env to deploy.
# Indexer: indexer/.env.example. Web: web/.env.example. Agents: agents/.env.example.
# The deployer key is PARON_DEPLOYER_PK. There is no second key variable.

CHAIN=robinhoodTestnet
PARAM_SET=demo
DEPLOY_LABEL=stage-1
# Unset uses EASGate. registry is the go/no-go soft fail.
GATE_KIND=

# Deploy RPC is RH_TESTNET_RPC in ops/.env.example. These are not aliases of it.
INDEXER_RPC_URL=
NEXT_PUBLIC_RPC_URL=

ETHERSCAN_API_KEY=
PARON_DEPLOYER_PK=
DEPLOYER_ADDRESS=
SAFE_ADDRESS=
TREASURY_ADDRESS=

W_ADMIN=
W_VERIFIER=
W_P_JKT=
W_P_BTM=
W_P_SGP=
W_BUY=
W_BUY2=
W_TRD=
W_JUDGE=
W_KEEP=
W_FEED=
W_ARB_1=
W_ARB_2=
W_ARB_3=

