# Copy to ops/.env. Never commit ops/.env. Placeholders only.
# Active chain is config/chains.json "active". Override with CHAIN.

CHAIN=robinhoodTestnet
DEPLOY_LABEL=stage-1
PARAM_SET=demo
# Unset uses EASGate. Set to registry only for the go/no-go soft fail.
GATE_KIND=
SEED_MODE=stage
SEED_CALLOUT=true

# Public RPC is fine for read-only go/no-go. Broadcast and the indexer need a keyed URL.
RH_TESTNET_RPC=https://<alchemy-rh-testnet-url-with-key>
RH_TESTNET_RPC_BACKUP=https://edge.goldsky.com/standard/evm/46630?key=<goldsky-key>
ARB_SEPOLIA_RPC=https://<alchemy-arb-sepolia-url-with-key>
ARB_SEPOLIA_RPC_BACKUP=https://<quicknode-or-infura-url>
ETHERSCAN_API_KEY=<etherscan-v2-key>

# Integrator machine only. 64 hex characters, no 0x. A leading 0x is accepted.
# Never put this on a command line and never commit it. Dry-run does not read it.
PARON_DEPLOYER_PK=
# PARON_BROADCAST=1 signs. PARON_SIMULATE=1 estimates gas and does not send. Leave both unset to dry-run.
PARON_BROADCAST=0
DEPLOYER_ADDRESS=0x<fresh-deployer-address>

# Demo actors. Addresses are fresh keys. Do not use the fixture addresses in dev doc 03.
W_P_JKT=0x<provider-jakarta>
W_P_BTM=0x<provider-batam>
W_P_SGP=0x<provider-singapore>
W_BUY=0x<buyer>
W_BUY2=0x<buyer-wallet-2-same-entity>
W_TRD=0x<trader>
W_JUDGE=0x<judge-gas-only>
W_VERIFIER=0x<w-verifier>
W_ADMIN=0x<w-admin>
W_KEEP=0x<keeper>
W_FEED=0x<reference-feed-signer>
W_ARB_1=0x<panel-1>
W_ARB_2=0x<panel-2>
W_ARB_3=0x<panel-3>
SAFE_ADDRESS=0x<team-safe-2of3>
TREASURY_ADDRESS=0x<safe-or-timelock>

# Per-actor keys for the seed command. W-DEP is PARON_DEPLOYER_PK, not a second variable.
# 64 hex characters. A leading 0x is accepted. Never commit.
KEY_W_VERIFIER=0x<verifier-key>
KEY_W_P_JKT=0x<provider-jakarta-key>
KEY_W_P_BTM=0x<provider-batam-key>
KEY_W_P_SGP=0x<provider-singapore-key>
KEY_W_BUY=0x<buyer-key>
KEY_W_BUY2=0x<buyer-2-key>
KEY_W_TRD=0x<trader-key>
KEY_W_FEED=0x<feed-signer-key>

# Working default until T5-01 is measured. At 0.01 gwei this is more than a full demo.
ETH_TARGET_WEI=20000000000000000
