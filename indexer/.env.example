# Placeholders only. Do not commit real RPC keys or database passwords.
# Copy to `.env` for local `pnpm dev`. Leave DATABASE_URL empty: Ponder then uses PGlite.

# robinhoodTestnet | arbitrumSepolia
CHAIN=robinhoodTestnet

# Manifest label: deployments/<chainId>/<label>.json (written by L4 DeployAll)
DEPLOY_LABEL=stage-1

# demo | prod
PARAM_SET=demo

# Archive-capable RPC. On Railway this is a secret (Alchemy or Goldsky), not the public RPC.
INDEXER_RPC_URL=https://rpc.testnet.chain.robinhood.com
INDEXER_RPC_URL_BACKUP=

# Empty locally (PGlite). On Railway, the Postgres plugin injects this at deploy time.
DATABASE_URL=

# Required whenever DATABASE_URL is set. Ponder keeps indexed tables in this Postgres schema.
# Use one stable name per deployment and do not change it: a new name backfills into an empty schema.
DATABASE_SCHEMA=paron

# Public base of this API, no custom domain (D-10). Railway's default hostname is fine.
API_PUBLIC_BASE_URL=https://<paron-api-host>/v1
API_CORS_ORIGIN=*

# Index TimelockController + AccessControl events (H42–H43).
TIMELOCK_INDEXED=true

# server = wall clock (testnet). chain = last indexed block timestamp (anvil, 05 P5-15).
API_NOW_SOURCE=server

# Railway sets PORT. Local default matches Ponder's 42069.
PORT=42069
