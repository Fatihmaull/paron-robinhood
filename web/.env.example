# Public testnet config. No secrets. See 04 §4.5.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_API_BASE_URL=https://paron-api.example/v1
# mock until the indexer is up. Production (VERCEL=1) refuses mock.
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_DEPLOY_LABEL=stage-1
# Leave empty to use an injected browser wallet (T4-04).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEMO_PRESETS=true
NEXT_PUBLIC_SHOW_SYNTHETIC_LABEL=true
# Empty hides the agent kill-switch toggle (D-42 fallback E).
NEXT_PUBLIC_AGENT_URL=

# Contract addresses. Empty until the deploy manifest exists.
# On-chain fallback then shows an honest load error (no invented balances).
NEXT_PUBLIC_ADDR_USDC=
NEXT_PUBLIC_ADDR_EAS=
NEXT_PUBLIC_ADDR_EAS_SCHEMA=
NEXT_PUBLIC_ADDR_PROVIDER_REGISTRY=
NEXT_PUBLIC_ADDR_SERIES_FACTORY=
NEXT_PUBLIC_ADDR_PRIMARY_SALE=
NEXT_PUBLIC_ADDR_ORDER_BOOK=
NEXT_PUBLIC_ADDR_REDEMPTION_MANAGER=
NEXT_PUBLIC_ADDR_BOND_VAULT=
NEXT_PUBLIC_ADDR_PRINT_INDEX=
NEXT_PUBLIC_ADDR_REFERENCE_FEED=
NEXT_PUBLIC_ADDR_CONVERSION_TABLE=
NEXT_PUBLIC_ADDR_TIMELOCK=
NEXT_PUBLIC_ADDR_PANEL=
# EASGate (linkAttestation). RegistryGate when the deploy has no EASGate.
NEXT_PUBLIC_ADDR_GATE=
NEXT_PUBLIC_ADDR_CU_TOKEN_SERIES_4=
