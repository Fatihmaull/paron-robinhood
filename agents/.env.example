# Copy to agents/.env. Never commit agents/.env.
# Placeholders only. Do not put a real key in this file.

CHAIN_ID=46630
DEPLOY_LABEL=stage-1
AGENT_RPC_URL=https://<alchemy-url-with-key>
API_BASE_URL=https://<paron-api-host>/v1

# on, true, or 1 stops every send from this process. off leaves the series pause check in charge.
AGENT_KILL_SWITCH=off
PROVIDER_AGENT_KILL_SWITCH=off

# Keeper stays dry-run during the demo so the judge calls claimDefault.
KEEPER_PRIVATE_KEY=0x<fresh-keeper-key>
KEEPER_DRY_RUN=true
KEEPER_KILL_SWITCH=off
KEEPER_POLL_SECONDS=60

# P5-26: auto during the demo. manual is the tested fallback.
TRADER_BOT_TRIGGER=auto
TRADER_BOT_ACCOUNT=paron-trader
TRADER_BOT_PRIVATE_KEY=0x<trader-key>
TRADER_BOT_DRY_RUN=true
TRADER_BOT_KILL_SWITCH=off
TRADER_BOT_POLL_SECONDS=15
TRADER_BOT_SERIES_ID=4
W_BUY=0x<buyer>
W_TRD=0x<trader>

# Optional. When unset, addresses are read from deployments/<CHAIN_ID>/<DEPLOY_LABEL>.json
# and the settlement token from deployments/<CHAIN_ID>/infra.json.
# SERIES_FACTORY_ADDRESS=
# PRIMARY_SALE_ADDRESS=
# ORDER_BOOK_ADDRESS=
# REDEMPTION_MANAGER_ADDRESS=
# SETTLEMENT_TOKEN_ADDRESS=
